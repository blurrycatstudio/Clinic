# ============================================================================
# VidaClinic WhatsApp AI Receptionist — environment variables
# Copy to apps/api/.env for local dev. In Vercel, set these under
# Project Settings -> Environment Variables for the apps/api project.
# ============================================================================

NODE_ENV=development
PORT=4000

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL= 
SUPABASE_SERVICE_ROLE_KEY= 
SUPABASE_JWT_SECRET=

# --- Redis (Upstash — REST API, not a redis:// connection string) ----------
UPSTASH_REDIS_REST_URL=https://xxxxxxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- WhatsApp Cloud API -------------------------------------------------------
# These four already exist per the project brief — fill in once available.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
# App secret from the Meta App dashboard, used to verify webhook signatures.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v20.0

# --- WhatsApp template names --------------------------------------------------
# LEAVE EMPTY until Meta approves each template. Once approved, paste the
# exact template name here (as registered in WhatsApp Manager) — nothing
# else in the codebase needs to change. See packages/shared/src/templates/registry.ts
WHATSAPP_TEMPLATE_APPOINTMENT_CONFIRMATION=
WHATSAPP_TEMPLATE_APPOINTMENT_REMINDER_24H=
WHATSAPP_TEMPLATE_APPOINTMENT_REMINDER_2H=
WHATSAPP_TEMPLATE_APPOINTMENT_RESCHEDULED=
WHATSAPP_TEMPLATE_APPOINTMENT_CANCELLED=
WHATSAPP_TEMPLATE_CLINIC_LOCATION=

# --- Voice: Vapi + ElevenLabs --------------------------------------------------
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
VAPI_ASSISTANT_ID=
# Required for outbound calling (staff "call to confirm" + reminder-call cron).
# Vapi dashboard -> Phone Numbers -> the number's id.
VAPI_PHONE_NUMBER_ID=
# Optional: a second assistant scripted for outbound confirmation/reminder
# calls. Falls back to VAPI_ASSISTANT_ID if unset.
VAPI_REMINDER_ASSISTANT_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Google Maps ---------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# --- Cloudflare R2 (media/document storage) -------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- Misc ------------------------------------------------------------------------
# Set this in Vercel too — Vercel Cron then sends it back as a Bearer token automatically.
CRON_SECRET=
# The deployed web dashboard's origin, for CORS. Use http://localhost:5173 for local dev.
DASHBOARD_ORIGIN=http://localhost:5173

# --- Voice/automation agent (n8n) machine auth ------------------------------------
# Shared secret the n8n voice-call tool handler sends as `x-agent-key` to
# /api/agent/*. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_API_KEY=

# ============================================================================
# apps/web (Vite) environment variables — put these in apps/web/.env.local
# ============================================================================
# VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=
# VITE_API_BASE_URL=http://localhost:4000/api
