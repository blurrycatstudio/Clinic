    "express": "^4.21.0",
    "openai": "^4.68.0",
    "pdfkit": "^0.20.2",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
